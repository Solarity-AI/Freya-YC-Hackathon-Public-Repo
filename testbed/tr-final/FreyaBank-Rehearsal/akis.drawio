<mxfile host="app.diagrams.net" version="24.7.0"><diagram id="akis" name="Ekstre Borcu Hattı Akışı"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Açılış: dijital asistan + kayıt cümlesi&lt;br&gt;'{ad} {soyad} ile mi görüşüyorum?'" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="240" height="64" as="geometry"/></mxCell><mxCell id="n2" value="Hattaki kişi müşteri mi?" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="240" height="64" as="geometry"/></mxCell><mxCell id="n3" value="Başkası: neden aradığını söyleme&lt;br&gt;Ne zaman ulaşılır? (bugün / sonraki iş günü&lt;br&gt;09:00–18:00, arife 09:00–12:30)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="240" height="64" as="geometry"/></mxCell><mxCell id="n4" value="GeriAramaPlanla" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="240" height="64" as="geometry"/></mxCell><mxCell id="n5" value="Kimlik: doğum tarihi (GG.AA.YYYY)&lt;br&gt;sonra T.C. kimlik no son 4&lt;br&gt;KimlikDogrula (toplam 3 hak)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="240" height="64" as="geometry"/></mxCell><mxCell id="n6" value="3 yanlış / ret → DOGRULANAMADI" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="240" height="64" as="geometry"/></mxCell><mxCell id="n7" value="EkstreBorcSorgula&lt;br&gt;En çok gecikmiş karttan başla" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="240" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Borcu bildir + 'Bu ödemeyi bugün yapabilir misiniz?'" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="240" height="64" as="geome